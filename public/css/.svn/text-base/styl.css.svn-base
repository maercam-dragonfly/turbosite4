body{
    background: url('../img/layout/top.png') repeat-x;
    background-color:#f0f0f0;
    margin:0;
    padding:0;
    
    
}
/*główny kontener*/
#container{
    margin: 0 auto;   
    overflow:hidden;
    width: 1002px;
    padding-top: 10px;
    
}
/*nagłówek*/
#header, #wrapper_content{
   margin: 0 auto;
}
#header{
    background: url('../img/layout/baner.png');
    background-color: rgb(82,105,158);
    width:960px;
    height:160px;
    padding: 10px;
    color:#fff;
}
#header h1{
    float: left;
    font-size: 22px;
    margin-bottom: 10px;
    margin-left: -20px;
    margin-top: 60px;
    text-shadow: #000000 0.08em 0.08em 0.4em;
}
#header h1 span{
    color: #0d4fb4;
    text-shadow: none;
}
#logo{	
    margin-right: 20px;
    margin-top: 20px;
    margin-left: 40px;
	margin: 0px;
    float:left;
}
#elka{	
    margin-top: 5px;
    float:left;
    background:url('../img/layout/elka_mala.png');
    height: 100px;
    margin-left: 270px;
    margin-top: 5px;
    width: 100px;
	-webkit-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -moz-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -ms-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -o-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
	box-shadow: #666666 5px 5px 5px 0px;
    z-index: 20;
    position: relative;
}
/* menu */
#menu{
    z-index: 30;
    height: 24px;
    border: double 3px #fff;
    background: rgb(0,20,100);
    padding:1px; 
    position: relative;
}
#wrapper_menu{
    z-index: 32;
    position: relative;
    width:1000px;
    border: solid 1px #fff;
    color: #fff;
    font-family: Calibri;
}
#menu ul, #menu ul li {
    display: block;
    list-style: none;
    margin: 0;
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 0px;
    padding-right: 0px;
    text-transform: uppercase;
}

#menu ul{
    display:block;
    margin-left: 0px;
    width: 980px;
}
#menu ul li {
    font-size: 18px;
    float: left;
}

#menu ul a:link, #menu ul a:visited {
    text-decoration: none;
    display: block;
    text-align: center;
    color: #fff;
    padding: 1px 7px ;
    font-weight: bold;
}

#menu ul a:hover {
    color: red;
}
#menu .active{
   color:red;
}
#main_content{
    min-height:300px;
    border: solid 2px  #001e64;
    background:#fff;
    padding-top: 0px;
    border-top-style: none;
}
#wrapper_content{
    width:975px;
    border: solid 3px  #fff;
    border-top-style: none;
    position: relative;
    z-index:    7;
}
#content_padding{
    background: #B00000;
    margin-left: 651px;
    width: 270px;
}
h2{
    color: red;
    text-shadow: black 0.05em 0.05em 0.1em;
}
h2 a{
    text-decoration: none;
    color: red;
}
h2 a:hover{
    color: #000;
}
h3{
    color:#666666;
    color:red;
    text-shadow: black 0.05em 0.05em 0.01em;
}
h4{
    color: #B00000;
    text-shadow: black 0.01em 0.01em 0.01em;
}
.data{
    color: #888;
}
#left{
    min-height: 505px;
    float:left;
    width:620px;
    padding: 10px;
    padding-left: 20px;
    background: #fff;
    margin-left: -651px;
}
#left h1{
    border-bottom: 1px #777 solid; 
}
#right{
    position: relative; 
    float:left;
    width:250px;
    padding: 10px;
    padding-top: 25px;
    z-index: 10;
    margin-top: -250px;
    background: #B00000;
    -background: orange;
    -border-left: 6px solid #1144FF;
}
/*karteczka*/
.katreczka{
    -webkit-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -moz-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -ms-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -o-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    width: 270px;
    box-shadow: #666666 5px 5px 5px 0px;
}
.katreczka dt{
    font-weight: 900;
    background-color: rgb(248, 246, 88);
    border-bottom-color: rgb(255, 255, 0);
    height: 22px;
    line-height: 22px;
    padding: 5px 10px;
}

.katreczka dd{
    margin: 0px;
    margin-top: -1px;
    line-height: 16px;
    padding: 5px 10px;
    background-color: #faf89b;
    display: block;
    min-height: 100px;
}
.pineska{
    width: 36px;
    height: 48px;
    background:url('../img/layout/pineska02.png');
    margin-left: 140px;
    margin-top: -40px;
}
.tresc{
    margin-left: 10px;
    margin-right: 15px;
}
.tresc img {
    margin-left: 100px;
    box-shadow: #666666 5px 5px 5px 0px;
}
.tresc a {
    color: red;
    text-decoration: none;
}
.tresc dl dt {
    color: red;
    -text-shadow: inherit;
    text-decoration: none;
    font-weight: 900;
}

.tresc p{
    text-align: justify;
}
/*stopka*/
#bottom{
    position: relative;
    z-index:    5;
    padding-top: 120px;
    margin-top: -120px;
    clear:both;
    background:url('../img/layout/bottom.png') repeat-x top;
    background-color: #001e64;
}

#footer{
    margin: 0 auto;
    overflow: hidden;
    width: 980px;
    color: #fff;
}
#footer_left, #footer_center, #footer_right{
    -min-height: 100px;
    -padding: 5px;
    float: left;
}
#footer_left{
    float:left; 
    width:690px;
    margin-top: 20px;
    margin-bottom:  20px;
}
#footer_center{
    -background:#777;
    -border-right: 1px solid #000;
}
#footer_right{
    padding: 0 px;
    text-align: left;
    width:260px;
    margin-top: 7px;
    margin-bottom:  7px;
    margin-left: 20px;
}
#menu_bottom ul, #menu_bottom ul li {
    font-size: 11px;
    font-family: "Verdana", "Arial", "Helvetica", sans-serif;
    text-transform: lowercase;
    list-style: none;
    margin: 0px;
    padding-left: 1px;
    float: left;
}

#menu_bottom ul li a:link, #menu_bottom ul li a:visited {
    text-decoration: none;
    -display: block;
    color: #fff;
    padding: 1px 7px ;
    cursor: pointer;
}

#menu_bottom ul li a:hover {
    -text-decoration:underline;
    text-decoration: none;
    -color:#0099CC;
    color:red;
}

#top_right{
   
    padding: 5px;
    margin-bottom: 80px;
    margin-top: 80px;
    text-align: left;
    width:210px;
    -background-color: blue;
    color: #fff;
    font-weight: bold;
}

#linki{
    padding: 5px 5px;
    text-align: left;
    width:240px;
    min-height: 100px;
    margin-top: 50px;
    color: #fff;
    font-weight: bold;

}
#linki h1 { 
    float: left;
    font-size: 20px;
    margin-bottom: 10px;
    margin-left: 0px;
    margin-top: 0px;
    text-shadow: #000000 0.08em 0.08em 0.4em;
 }

 #linki ul{
     padding-left: 7px;
 }
 
 #linki ul, #linki ul li a { 
    list-style: none;
    display: block;
    float: left;
    font-size: 14px;
    margin-bottom: 3px;
    margin-top: 3px;
    color: #fff;
    text-decoration: none;
    width:210px;
 }
 
 #linki ul li a:hover{ 
    color:#888;
 }
 