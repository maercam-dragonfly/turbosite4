body{
    background: url('../img/layout/top.png') repeat-x;
    -background-color:#f0f0f0;
    background-color:#eeefff;
    margin:0;
    padding:0;
}
/*główny kontener*/
#container{
    margin: 0 auto;   
    overflow:hidden;
    width: 980px;
    padding-top: 10px;
    -border: 1px solid #eee;
    -box-shadow: #bbb 3px 3px 3px 9px;
}
/*nagłówek*/
#header, #wrapper_content{
   margin: 0 auto;
}
#header{
    background: url('../img/layout/baner8.png');
    width:980px;
    height:160px;
    padding: 10px;
    color:#fff;
}
#header h1{
    float: left;
    font-size: 22px;
    margin-bottom: 10px;
    margin-left: 0px;
    margin-top: 60px;
    text-shadow: #000000 0.08em 0.08em 0.4em;
}
#header h1 span{
    color:#777;
    text-shadow: none;
}
#logo{	
    margin-right: 0px;
    margin-top: 0px;
    margin-left: 0px;
    float:left;
}
#elka{	
    margin-top: 5px;
    float:left;
    background:url('../img/layout/elka_mala.png');
    height: 100px;
    margin-left: 250px;
    margin-top: 5px;
    width: 100px;
    -webkit-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -moz-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -ms-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -o-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    box-shadow: #666666 5px 5px 5px 0px;
    z-index: 20;
    position: relative;
}
/* menu */
#menu{
    z-index: 30;
    height: 30px;
    -border: double 3px #fff;
    -background: rgb(0,20,100);
    background:#666666;
    padding:1px; 
    position: relative;
    border-bottom: 6px solid #cf0000;
}
#wrapper_menu{
    -z-index: 32;
    -position: relative;
    width:980px;
    -border: solid 1px #fff;
    -color: #fff;
    font-family: Calibri;
}
#menu ul, #menu ul li {
    display: block;
    list-style: none;
    margin: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    padding-right: 2px;
    text-transform: uppercase;
}

#menu ul{
    display:block;
    margin-left: 0px;
    width: 980px;
}
#menu ul li {
    font-size: 17px;
    float: left;
    text-shadow: #cf0000  0.1em 0.1em 0.1em;
    -box-shadow: #cf0000 3px 3px 3px 3px;
}

#menu ul a:link, #menu ul a:visited {
    text-decoration: none;
    display: block;
    text-align: center;
    color: #fff;
    padding: 1px 7px ;
    font-weight: bold;
}

#menu ul a:hover {
    color: #cf0000;
    text-shadow: #333  0.1em 0.1em 0.1em;
}
#menu .active{
   color:#cf0000;
}
#main_content{
    min-height:300px;
    -border: solid 2px  #001e64;
    background:#fff;
    padding-top: 0px;
    border-top-style: none;
}
#wrapper_content{
    width:980px;
    -border: solid 3px  #fff;
    border-top-style: none;
    position: relative;
    z-index:    7;
}
#content_padding{
    background: #999;
    margin-left: 651px;
    width: 270px;
}
h2{
    color:#cf0000;
    text-shadow: black 0.05em 0.05em 0.1em;
    font-size: 18px;
}
h2 a,h2 a:link,h2 a:visited{
    text-decoration: none;
    color: #cf0000;
}
h2 a:hover{
    color: #000;
}
h3{
    color:#333333;
    text-shadow: black 0.05em 0.05em 0.01em;
    font-size: 17px;
}
h4{
    color:#cf0000;
    text-shadow: black 0.04em 0.04em 0.01em;
    font-size: 16px;
}
p{
    font-size: 14px;
}


table.raty{
    border: 1px;
    background-color:#f0f0f0;
    margin-left: 60px;
    border: solid #888;
}

table.lista td{
    padding: 2px 2px;
    width: 100px;
    border: 2px solid #fff;
    font-size:1.4ex;
}
table.lista thead{
    background: #000;
    color: #fff;
    
}
table.lista tr.w2{
    background: #eee;
}

table.lista tr.w1{
    background: #aaa;
}

table.raty tr td{
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 20px;
    padding-right: 20px;
    border: thin solid #888;
}

.data{
    color: #888;
}
#left{
    min-height: 505px;
    float:left;
    width:615px;
    padding: 10px;
    padding-left: 20px;
    background: #fff;
    margin-left: -651px;
    border-right: 6px solid #cf0000;
}
#left h1{
    border-bottom: 1px #777 solid; 
}
#right{
    position: relative; 
    float:left;
    width:250px;
    padding: 10px;
    padding-top: 25px;
    z-index: 10;
    margin-top: -250px;
    background:#999;
    border-left: 6px solid #cf0000;
    margin-left: -6px;
}
/*karteczka*/
.katreczka{
    -webkit-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -moz-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -ms-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -o-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    width: 270px;
    box-shadow: #666666 5px 5px 5px 0px;
}
.katreczka dt{
    font-weight: 900;
    background-color: #cf0000;
    height: 22px;
    line-height: 22px;
    padding: 5px 10px;
    text-transform: uppercase;
}

.katreczka dd{
    margin: 0px;
    margin-top: -1px;
    line-height: 16px;
    padding: 5px 10px;
    background-color: #ffeaea;
    display: block;
    min-height: 100px;
}
.tresc dd{
    font-size: 14px;
}
.katreczka dd .wyroznienie{
    color: #cf0000;
    font-weight: bold;
    font-size: 20px;
    margin: 0px;
    padding-top: 20px;
    text-shadow: black 0.05em 0.05em 0.1em;
}
.katreczka dd .wyroznienie2{
    color:black;
    font-size: 16px;
    margin: 0px;
    padding-top: 10px;
    -text-shadow: black 0.05em 0.05em 0.1em;
}
.pineska{
    width: 36px;
    height: 48px;
    -background:url('../img/layout/pineska02.png');
    margin-left: 140px;
    margin-top: -40px;
}
.tresc{
    -background-color: yellow;
    margin-left: 10px;
    margin-right: 15px;
}
.tresc img {
    margin-left: 100px;
    box-shadow: #666666 5px 5px 5px 0px;
}
.tresc a {
    color: #cf0000;
    text-decoration: none;
}
.tresc dl dt {
    color: #cf0000;
    -text-shadow: inherit;
    text-decoration: none;
    font-weight: 900;
}

.tresc p{
    text-align: justify;
}
/*stopka*/
#bottom{
    position: relative;
    z-index:    5;
    padding-top: 120px;
    margin-top: -120px;
    clear:both;
    background:url('../img/layout/bottom.png') repeat-x top;
    -background-color: #001e64;
}

#footer{
    -background-color:#666666;
    border-top: 6px solid #cf0000;
    border-top-color:#cf0000;
    margin: 0 auto;
    overflow: hidden;
    width: 980px;
    color: #fff;
}
#footer_left, #footer_center, #footer_right{
    -min-height: 100px;
    -padding: 5px;
    float: left;
}
#footer_left{
    float:left; 
    width:690px;
    margin-top: 20px;
    margin-bottom:  20px;
}
#footer_center{
    -background:#777;
    -border-right: 1px solid #000;
}
#footer_right{
    padding: 0 px;
    text-align: left;
    width:260px;
    margin-top: 7px;
    margin-bottom:  7px;
    margin-left: 20px;
}
#menu_bottom ul, #menu_bottom ul li {
    font-size: 11px;
    font-family: "Verdana", "Arial", "Helvetica", sans-serif;
    text-transform: lowercase;
    list-style: none;
    margin: 0px;
    padding-left: 1px;
    float: left;
}

#menu_bottom ul li a:link, #menu_bottom ul li a:visited {
    text-decoration: none;
    -display: block;
    color: #fff;
    padding: 1px 7px ;
    cursor: pointer;
}

#menu_bottom ul li a:hover {
    -text-decoration:underline;
    text-decoration: none;
    -color:#0099CC;
    color:#cf0000;
}

#top_right{
   
    padding: 5px;
    margin-bottom: 80px;
    margin-top: 80px;
    text-align: left;
    width:210px;
    -background-color: blue;
    color: #fff;
    font-weight: bold;
}

#linki{
    padding: 5px 5px;
    text-align: left;
    width:240px;
    min-height: 100px;
    margin-top: 50px;
    color: #fff;
    font-weight: bold;

}
#linki h1 { 
    float: left;
    font-size: 20px;
    margin-bottom: 10px;
    margin-left: 0px;
    margin-top: 0px;
    color: #cf0000;
    text-shadow: #000000 0.08em 0.08em 0.4em;
 }

 #linki ul{
     padding-left: 7px;
 }
 
 #linki ul, #linki ul li a { 
    list-style: none;
    display: block;
    float: left;
    font-size: 14px;
    margin-bottom: 3px;
    margin-top: 3px;
    color: #fff;
    text-decoration: none;
    width:210px;
 }
 
 #linki ul li a:hover{ 
    color:#cf0000;
 }
.artukul{
    background-color: #fff;
    border: 1px solid #eee;
    margin-top: 20px;
    margin-bottom: 20px;
    -moz-border-radius:5px; /* FF */
    -webkit-border-radius:5px; /* przeglądarki z webkitem (Safari, Chrome itp.) */
    -khtml-border-radius:5px; /* przeglądarki typu K-meleon (typowo Linuxowe) */
    border-radius:5px; /* pozostałe przeglądarki */
    -behaviour:url(border-radius.htc); /* dodatek dla badzIEwnej przeglądarki */
    box-shadow: #ddd 5px 5px 5px 0px;
}
.artukul h2{
    background-color:#eee;
    padding: 5px;
    margin: 0px;
    font-size: 18px;
}
.artukul .data{
    padding: 5px;
    margin: 0px;
}
.artukul .tresc{
    padding: 5px;
    margin: 0px;
}
.tresc .gg{
    box-shadow: none;
    margin: 0px;
    padding: 0px;
}