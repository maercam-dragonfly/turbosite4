body{
    background: url('../img/layout/top.png') repeat-x;
    -background-color:#f0f0f0;
    -background-color:#eeefff;
    background-color: #ffe5be;
    -background-color: #111;
    margin:0;
    padding:0;
}
/*główny kontener*/
#container{
    margin: 0 auto;   
    overflow:hidden;
    width: 980px; 
    padding-top: 10px;
    -border: 1px solid #0f0;
    -box-shadow: #bbb 3px 3px 3px 9px;
}
/*nagłówek*/
#header, #wrapper_content, #wrapper_menu{
   margin: 0 auto;
}
#header{
    background: url('../img/layout/baner3.png');
    width:980px;
    height:340px;
    padding-left: 0px;
    padding-right: 0px;
    padding-top: 10px;
    color:#fff;
}
#header h1{
    
    font-size: 10px;
    float: right;
    font-size: 22px;
    margin-right: 10px;
    margin-bottom: 0px;
    margin-left: 10px;
    margin-top: 0px;
    text-shadow: #777 0.08em 0.08em 0.4em;
    color: #555;
    
}
#header h1.title{
    width:395px;
}

