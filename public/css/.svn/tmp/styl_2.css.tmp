/* menu */
#menu{
    -border: double 3px #fff;
    -background: rgb(0,20,100);
    -background:#666666;
    width: 980px;
    height: 30px;
    margin-left: 0px;
    padding:0px; 
    border-bottom: 3px solid #FF8C00;
}
#wrapper_menu{
    width:980px;
    -margin: 0px;
    padding: 0px;
    -border: solid 1px #fff;
    -color: #fff;
    margin-top: -40px;
}
#menu ul, #menu ul li {
    display: block;
    list-style: none;
    margin: 0px;
    padding: 0px;
    -width: 95px;
    height: 20px;
    text-transform: uppercase;
}

#menu ul{
    display:block;
    margin: 0px;
    width: 980px;
}
#menu ul li {
    font-size: 14px;
    float: left;
    background-image: url('../img/layout/button.png');
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    margin-top: 0px;
    margin-bottom: 0px;
    margin-left: 2px;
    margin-right: 2px;
    text-shadow: #FF8C00  0.1em 0.1em 0.1em;
    -text-shadow: #fff  0.1em 0.1em 0.1em;
    -box-shadow: #FF8C00 3px 3px 3px 3px;
}

#menu ul a:link, #menu ul a:visited {
    text-decoration: none;
    display: block;
    text-align: center;
    color: #222;
    padding: 1px 7px ;
    font-weight: bold;
}

#menu ul a:hover {
    color: #FF8C00;
    text-shadow: #333  0.1em 0.1em 0.1em;
}

#menu ul li:hover {
    background-image: url('../img/layout/button_hover.png');
    color: #FF8C00;
    text-shadow: #333  0.1em 0.1em 0.1em;
}
#menu .active{
   color:#FF8C00;
}
#main_content{
    min-height:300px;
    border-bottom: 3px solid #FF8C00;
    background:#fff;
    padding-top: 0px;
    border-top-style: none;
    z-index: 10;
    position: relative;
}
#wrapper_content{
    width:980px;
    -border: solid 3px #f00;
    border-top-style: none;
    position: relative;
    z-index:    7;
}
#content_padding{
    background: #666;
    margin-left: 651px;
    width: 270px;
}
h2{
    color:#FF8C00;
    text-shadow: black 0.05em 0.05em 0.1em;
    font-size: 18px;
}
h2 a,h2 a:link,h2 a:visited{
    text-decoration: none;
    color: #FF8C00;
}
h2 a:hover{
    color: #000;
}
h3{
    color:#333333;
    text-shadow: black 0.05em 0.05em 0.01em;
    font-size: 17px;
}
h4{
    color:#FF8C00;
    text-shadow: black 0.04em 0.04em 0.01em;
    font-size: 16px;
}
p{
    font-size: 14px;
}

table.raty{
    border: 1px;
    background-color:#f0f0f0;
    margin-left: 60px;
    border: solid #888;
}

table.lista td{
    padding: 2px 2px;
    width: 100px;
    border: 2px solid #fff;
    font-size:1.4ex;
}
table.lista thead{
    background: #000;
    color: #fff;
    
}
table.lista tr.w2{
    background: #eee;
}

table.lista tr.w1{
    background: #aaa;
}

table.raty tr td{
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 20px;
    padding-right: 20px;
    border: thin solid #888;
}

.data{
    color: #888;
}
#left{
    min-height: 505px;
    float:left;
    width:618px;
    padding: 10px;
    padding-left: 20px;
    background: #fff;
    margin-left: -651px;
    border-right: 3px solid #FF8C00;
}
#left h1{
    border-bottom: 1px #777 solid; 
    background: url('../img/layout/top1h.png') no-repeat;
    height: 40px;
}
#right{
    position: relative; 
    float:left;
    width:250px;
    padding: 10px;
    padding-top: 5px;
    z-index: 10;
    -margin-top: -250px;
    background: #666;
    border-left: 3px solid #FF8C00;
    margin-left: -3px;
}
/*karteczka*/
.katreczka{
    -webkit-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -moz-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -ms-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    -o-transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    transform: matrix(0.99, 0.07, -0.07, 0.99, 18.14, 7.556);
    width: 270px;
    box-shadow: #666666 5px 5px 5px 0px;
}
.katreczka dt{
    font-weight: 900;
    -background-color: #FF8C00;
    padding-left: 55px;
    background-color: #597eff;
    background-image: url('../img/layout/Ltopkarteczka.png');
    height: 22px;
    line-height: 22px;
    padding-top: 7px;
    padding-bottom: 7px;
    text-transform: uppercase;
}

.katreczka dd{
    margin: 0px;
    margin-top: -1px;
    line-height: 16px;
    padding: 5px 10px;
    -background-color: #deefff;
    -background-color: #ebefff;
    background-color: #ffe5be;
    display: block;
    min-height: 100px;
}
.tresc dd{
    font-size: 14px;
}
.katreczka dd b{
    color: #FF8C00;
    font-weight: bold;
    font-size: 20px;
    margin: 0px;
    padding-bottom: 20px;
    padding-top: 20px;
    text-shadow: black 0.05em 0.05em 0.1em;
}
.katreczka dd p{
    color:black;
    font-size: 16px;
    margin: 0px;
    padding-top: 10px;
    padding-bottom: 20px;
}
.pineska{
    width: 36px;
    height: 48px;
    -background:url('../img/layout/pineska02.png');
    margin-left: 140px;
    margin-top: -40px;
}
.tresc{
    margin-left: 10px;
    margin-right: 15px;
}
.tresc img {
    margin-left: 100px;
    box-shadow: #666666 5px 5px 5px 0px;
}
.tresc a {
    color: #FF8C00;
    text-decoration: none;
}
.tresc dl dt {
    color: #FF8C00;
    -text-shadow: inherit;
    text-decoration: none;
    font-weight: 900;
}

.tresc p{
    text-align: justify;
}
/*stopka*/
#bottom{
    -position: relative;
    z-index:    5;
    padding-top: 120px;
    margin-top: -120px;
    -clear:both;
    background:url('../img/layout/bottom.png') repeat-x top;
    -background-color: #001e64;
    width: 100%;
}

#footer{
    -background-color:#666666;
    -border-top: 3px solid #FF8C00;
    -border-top-color:#FF8C00;
    margin: 0 auto;
    overflow: hidden;
    width: 980px;
    color: #fff;
    position: relative;
    z-index: 30;
}
#footer_left, #footer_center, #footer_right{
    -min-height: 100px;
    -padding: 5px;
    -padding-left: 65px;
    float: left;
}
#footer_left{
    float:left; 
    width:690px;
    margin-top: 20px;
    margin-bottom:  20px;
}
#footer_center{
    -background:#777;
    -border-right: 1px solid #000;
}
#footer_right{
    -background:url('../img/layout/pacholki_male_z_tlem.png') no-repeat;
    -border: 2px solid red;
    text-align: left;
    -width:350px;
    padding-top: 130px;
    margin-top: -110px;
    -margin-right: -180px;
    height: 91px;
    position: relative;
    z-index: 55;
}
#menu_bottom ul, #menu_bottom ul li {
    font-size: 11px;
    font-family: "Verdana", "Arial", "Helvetica", sans-serif;
    text-transform: lowercase;
    list-style: none;
    margin: 0px;
    padding-left: 1px;
    float: left;
}

#menu_bottom ul li a:link, #menu_bottom ul li a:visited {
    text-decoration: none;
    -display: block;
    color: #fff;
    padding: 1px 7px ;
    cursor: pointer;
}

#menu_bottom ul li a:hover {
    -text-decoration:underline;
    text-decoration: none;
    -color:#0099CC;
    color:#FF8C00;
}

#header #adres{
    padding: 0px;
    margin-bottom: 10px;
    float: right;
    margin-left: 10px;
    text-align: left;
    width:200px;
    text-shadow: #777 0.08em 0.08em 0.4em;
    color: #555;
    font-weight: bold;
}

#linki{
    padding: 5px 5px;
    text-align: left;
    width:240px;
    min-height: 100px;
    margin-top: 50px;
    color: #fff;
    font-weight: bold;

}
#linki h1 { 
    float: left;
    font-size: 20px;
    margin-bottom: 10px;
    margin-left: 0px;
    margin-top: 0px;
    color: #FF8C00;
    text-shadow: #000000 0.05em 0.05em 0.1em;
 }

 #linki ul{
     padding-left: 7px;
 }
 
 #linki ul, #linki ul li a { 
    list-style: none;
    display: block;
    float: left;
    font-size: 14px;
    margin-bottom: 3px;
    margin-top: 3px;
    color: #fff;
    text-decoration: none;
    width:210px;
 }
 
 #linki ul li a:hover{ 
    color:#FF8C00;
 }
.artukul{
    background-color: #fff;
    border: 1px solid #eee;
    margin-top: 20px;
    margin-bottom: 20px;
    -moz-border-radius:5px; /* FF */
    -webkit-border-radius:5px; /* przeglądarki z webkitem (Safari, Chrome itp.) */
    -khtml-border-radius:5px; /* przeglądarki typu K-meleon (typowo Linuxowe) */
    border-radius:5px; /* pozostałe przeglądarki */
    -behaviour:url(border-radius.htc); /* dodatek dla badzIEwnej przeglądarki */
    box-shadow: #ddd 5px 5px 5px 0px;
}
.artukul h2{
    -background-color:#eee;
    background-color: #c6d2ff;
    background-image: url('../img/layout/Ltopartykul.png');
    background-repeat: repeat-x;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 35px;
    margin: 0px;
    font-size: 18px;
    min-height: 21px;
}
.artukul .data{
    padding: 5px;
    margin: 0px;
}
.artukul .tresc{
    padding: 5px;
    margin: 0px;
}
.tresc .gg{
    box-shadow: none;
    margin: 0px;
    padding: 0px;
    width: 30px;
    height: 30px;
}

.tresc .ikonka{
    box-shadow: none;
    margin: 0px;
    padding: 0px;
}

.tresc .foto_left{
    margin-left: 0px;
    margin-right: 20px;
    margin-bottom: 20px;
    padding: 0px;
    border: 1px solid #888888;
    float: left;
}

.tresc .foto_right{
    margin-left: 20px;
    margin-right: 0px;
    margin-bottom: 20px;
    padding: 0px;
    border: 1px solid #888888;
    float: right;
}
.tresc .pdf ul li{
    list-style: none outside;
}
.tresc .pdf ul li a { 
    background: url('../img/bazawiedzy/maly_pdf.png') no-repeat;
    color: #000;
    display: block;
    padding: 0px 0px 15px 30px;
    font-size: 14px;
 }
 
.adresikonki{
    margin: 0px;
    padding: 0px;
}
.adresikonki li{
    list-style: none outside;
}
 
.adresikonki .i_adres { 
    background: url('../img/layout/kontakt/adres50.png') no-repeat;
    padding: 0px 0px 10px 40px;
    margin: 0px;
 }
.adresikonki .i_telefon { 
    background: url('../img/layout/kontakt/telefon50.png') no-repeat;
    padding: 0px 0px 10px 40px;
 }
.adresikonki .i_mail { 
    background: url('../img/layout/kontakt/mail50.png') no-repeat;
    padding: 0px 0px 10px 40px;
 }
.adresikonki .i_www { 
    background: url('../img/layout/kontakt/www50.png') no-repeat;
    padding: 0px 0px 10px 40px;
 }
.adresikonki .i_gg { 
    padding: 0px 0px 0px 0px;
 }
 
