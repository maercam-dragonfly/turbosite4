<small style="/*color:#000;float:left;margin-top: 100px;margin-left: -90px;/*left: 240px;top: 120px;position: absolute;z-index: 20;padding: 10px;text-align: left;*/">
           <?php $user = Zend_Auth::getInstance()->getIdentity();
          $modul = Zend_Controller_Front::getInstance()->getRequest()->getModuleName();
            if (null !== $user) {

                echo 'Zalogowany jako <b>' . $user->login . '</b><br/>';
                
                if( $modul === 'default'){   
                    echo '<a href="' . $this->url(array('controller' => 'index','action' => 'index'),'admin') . '">Panel admina</a>';
                }
                else{
                    echo '<a href="' . $this->url(array('controller' => 'index','action' => 'index'),'default') . '">strona</a>';
                
                }
                echo '<a href="' . $this->url(array('controller' => 'index','action' => 'logout'),'admin') . '">Wyloguj się</a>';
            } else {
                if( $modul !== 'default'){
                echo '<a href="' . $this->url(array('controller' => 'index','action' => 'login'),'admin') . '">Zaloguj się</a>';
                }
                
            }
                
            ?>
</small>