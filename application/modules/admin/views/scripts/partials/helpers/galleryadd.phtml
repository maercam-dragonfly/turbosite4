            <input  type="text" name="name_gallery" value="<?php echo $this->gallery['name']; ?>"/>
        </div>
        <input class="id_gallery" name="id_gallery" type="hidden" value="<?php echo $this->gallery['id']; ?>"/>
        <div class="submit-group">
            <input id="addGalerySubmit" type="submit" value="<?php echo $this->gallery['submit_label']; ?>" />
