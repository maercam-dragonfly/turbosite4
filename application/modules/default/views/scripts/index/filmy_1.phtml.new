<script type="text/javascript" >
    function jumpScroll() {
        window.scroll(0,485); // horizontal and vertical scroll targets
    }
    $('.kamerka_szary').click(function(e){ 
        
        tytul = "";
        tytul = $(this).text();
        //// opisik = "";
        // $('#tytul').text(tytul);
        ////  $('#opisik').text(opisik);
        //$('#opis').attr('style', "background-color: #fff;");
        //$('#tytul').attr('style', "background-color: #fff;");
        //$('#tv iframe').slideUp('slow');
        //$('#tv img').slideDown('slow');
        jumpScroll();
        return false;
    });
    
    
    $('.kamerka, .kamerka_new, .film_mini').click(function(e){
        $('#tv iframe').attr('src',$(this).attr('href'));
        
        tytul = $(this).text();
        ////  opisik = $(this).attr('content');
        //  $('#opis').attr('style', "background-color: #ffd;");
        //  $('#tytul').attr('style', "background-color: #ffb;");
        //  $('#tytul').text(tytul);
        //  $('#opisik').text(opisik);
        
        //alert(cont);
        
        $('#tv img').slideUp('slow');
        $('#tv iframe').slideDown('slow');
        jumpScroll();
        return false;
    });
    
    
</script>

