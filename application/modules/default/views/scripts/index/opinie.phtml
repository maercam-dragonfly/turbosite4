      $folder = 'img/galeria/strona_galeria/galeria_duze/';
      $dozwolone_rozszerzenia = ['jpg', 'jpeg', 'png', 'gif', 'webp'];

      // Sprawdź czy folder istnieje
      if (is_dir($folder)) {
        foreach (scandir($folder) as $plik) {
          $sciezka = $folder . $plik;
          $ext = pathinfo($plik, PATHINFO_EXTENSION);
          $nazwaBezRozszerzenia = pathinfo($plik, PATHINFO_FILENAME);

          if (in_array(strtolower($ext), $dozwolone_rozszerzenia)) {
            echo '
            <div class="col-6 col-md-4 col-lg-3">
              <a href="' . $sciezka . '" data-lightbox="galeria" data-title="' . htmlspecialchars($nazwaBezRozszerzenia) . '">
                <img src="' . $sciezka . '" alt="' . htmlspecialchars($nazwaBezRozszerzenia) . '" class="img-fluid">
              </a>
            </div>';
          }
        }
      } else {
        echo '<p>Nie znaleziono folderu z galerią.</p>';
      }
