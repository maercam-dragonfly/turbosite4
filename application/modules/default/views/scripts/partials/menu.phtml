<?php foreach ($this->container as $page): ?>
    <?php if ($page->label === 'Kontakt'): ?>
        <!-- Wyjątek: strona "Kontakt" bez dropdowna -->
        <div class="nav-item">
            <a href="<?php echo $page->href; ?>" class="nav-link me-4">
                <?php echo $page->label; ?>
            </a>
        </div>
    <?php else: ?>
        <!-- Normalne menu z dropdownem -->
        <div class="nav-item dropdown">
            <a 
                href="<?php echo $page->href; ?>" 
                class="nav-link dropdown-toggle me-4" 
                data-bs-toggle="dropdown" 
                role="button" 
                aria-expanded="false"
            >
                <?php echo $page->label; ?>
            </a>
            <?php if ($page->hasPages()): ?>
                <div class="dropdown-menu fade-down m-0">
                    <?php foreach ($page->getPages() as $subpage): ?>
                        <a 
                            class="dropdown-item" 
                            href="<?php echo $subpage->getHref(); ?>"
                        >
                            <?php echo $this->escape($subpage->getLabel()); ?>
                        </a>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
        </div>
    <?php endif; ?>
<?php endforeach; ?>
