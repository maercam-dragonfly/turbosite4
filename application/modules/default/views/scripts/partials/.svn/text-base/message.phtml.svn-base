<style>
    #layout_message{

        z-index: 10000;
        background-color: rgba(119, 119, 119, 0.702);
        width:100%;
        height:100%;
        position:fixed;
        margin:0 auto;

    }
    .container_message{
        margin: 0 auto;
        display: table;
        height:95%;
    }
    .padding_message{
        display: table-cell;
        vertical-align: middle;

    }
    .dialog{	
        -width: 400px;
        -height: 400px;	
        -padding: 10px;
        -background-color:#fff;
        -border: 1px solid #000;
        -box-shadow: #222 5px 5px 20px 0px;
    }
    .dialog .buttons button{
        -background-color:#fff;
        -border: 1px solid #000;
        border: 0px;
        padding:3px;
        width:70px;
        display: inline;
        float: none;


    }
    .dialog .message_text{
        height:85%;
    }
    .buttons{
        text-align:center;
        margin:0 auto;
        background-color: #FFE5BE;
        padding-bottom: 3px;
    }

</style>
<div id="layout_message"> 
    <div class="container_message">
        <div class="padding_message">
            <div class="karteczka dialog" >
                <dl>
                    <dt>
                        <?php echo $this->dialogMessage['title'] ?>
                    </dt>
                    <dd class="_news">
                        <?php echo $this->dialogMessage['text'] ?>
                    </dd>
                    <form action="">
                        <div class="buttons">
                            <button class="przycisk">OK</button>
                        </div>
                    </form>
                </dl>

            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $('#layout_message button').click(function(){
        $('#layout_message').css('display','none');
    });
    $('form').submit(function(){
        return false;
    });
</script>
