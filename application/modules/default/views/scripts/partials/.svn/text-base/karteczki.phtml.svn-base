<?php

if (isset($this->karteczki)) {
    foreach ($this->karteczki as $karteczka) {
        if ($karteczka['active']) {
            ?>
            <div class="karteczka" id="<?php echo $karteczka['name'] ?>" >
                <dl>
                    <dt>
                    <?php echo $karteczka['title'] ?>
                    </dt>
                    <dd class="_news">
                        <?php echo $karteczka['content'] ?>
                    </dd>
                </dl>
            </div>

            <?php
        }
    }
}